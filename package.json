{
  "private": true,
  "scripts": {
    "bootstrap": "lerna bootstrap --hoist",
    "serve": "curl pad.js.org | node",
    "dev": "docz dev",
    "watch": "lerna run build --no-sort --stream --bail --concurrency 999 -- -- --watch",
    "lint": "eslint packages",
    "test": "CI=true npm run test-watch -- -- --coverage",
    "test-coverage": "npm run test-watch -- -- --coverage",
    "test-updateSnapshot": "npm run test-watch --updateSnapshot",
    "test-watch": "lerna run test --no-sort --stream --concurrency 999",
    "release": "lerna publish --yes",
    "generate": "plop --plopfile ./templates/plopfile.js"
  },
  "devDependencies": {
    "docz": "^0.12.12",
    "eslint": "^5.9.0",
    "eslint-config-airbnb": "^17.1.0",
    "eslint-plugin-import": "^2.14.0",
    "eslint-plugin-jsx-a11y": "^6.1.2",
    "eslint-plugin-react": "^7.11.1",
    "execa": "1.0.0",
    "fs-extra": "7.0.0",
    "get-port": "^4.0.0",
    "globby": "^8.0.1",
    "husky": "^1.1.4",
    "jest": "23.6.0",
    "lerna": "3.5.0",
    "lerna-changelog": "^0.7.0",
    "lint-staged": "^7.0.5",
    "meow": "^5.0.0",
    "multimatch": "^2.1.0",
    "plop": "^2.1.0",
    "prettier": "1.14.3",
    "strip-ansi": "^4.0.0",
    "tempy": "^0.2.1",
    "wait-for-localhost": "2.0.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "packages/**/*/*.{js,md,css}": [
      "prettier --write",
      "eslint"
    ],
    "yarn.lock": [
      "git rm --cached"
    ]
  },
  "dependencies": {
    "eslint-config-prettier": "^3.3.0",
    "eslint-plugin-prettier": "^3.0.0"
  }
}
