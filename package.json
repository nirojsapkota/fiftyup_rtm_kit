{
  "private": true,
  "name": "rtm-kit",
  "rtmRollup": {
    "globalMap": {
      "styled-components": "styled",
      "cloneDeep": "lodash.clonedeep",
      "toPath": "lodash.topath"
    }
  },
  "scripts": {
    "bootstrap": "lerna bootstrap --no-ci",
    "build:docs": "docz build",
    "build:ci": "CI=true lerna run --parallel build -- -- --colors",
    "commit": "npx git-cz",
    "copy:builds": "node ./scripts/copyBuilds",
    "clean": "lerna exec -- rm -rf ./node_modules && lerna exec -- rm -f package-lock.json && lerna exec -- rm -rf ./build && lerna exec -- rm -rf ./coverage",
    "serve": "curl pad.js.org | node",
    "dev": "docz dev",
    "format": "rtm-scripts format --p templates/plopfile.js",
    "lint": "eslint packages",
    "test:scope": "node scripts/scoped-test tracker",
    "test:ci": "CI=true lerna run test --parallel --stream --concurrency 999 -- -- --coverage --silent --verbose",
    "test:watch": "lerna run test --parallel --no-sort --stream --concurrency 999 -- -- --colors --watch",
    "test:coverage": "lerna run test --parallel --no-sort --stream --concurrency 999 -- -- --colors --coverage",
    "release": "lerna publish --yes",
    "generate": "plop --plopfile ./templates/plopfile.js",
    "watch": "lerna run --parallel build -- -- --watch --colors",
    "zip": "rtm-scripts zip --p ./aws/GithubDocumentationFunction",
    "temp:test1": "lerna run test --stream --scope @rtm-ui/login-calculator-panel -- -- --colors --coverage",
    "temp:test2": "lerna run test --stream --scope @rtm-ui/form -- -- --colors --coverage",
    "temp:test3": "lerna run test --stream --scope @rtm-ui/electricity-switch -- -- --colors --coverage"
  },
  "devDependencies": {
    "@rtm/core": "^1.0.54",
    "@upstatement/prettier-config": "^0.3.0",
    "@xstate/react": "^0.7.1",
    "acorn": "^6.1.1",
    "acorn-dynamic-import": "^4.0.0",
    "axios": "^0.19.0",
    "babel-core": "^7.0.0-bridge.0",
    "babel-eslint": "^10.1.0",
    "babel-preset-react": "^6.24.1",
    "buble": "0.19.6",
    "color": "^3.1.1",
    "commitizen": "^4.2.4",
    "cz-conventional-changelog": "^2.1.0",
    "date-fns": "^1.30.1",
    "docz": "0.13.7",
    "docz-theme-default": "0.13.7",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.10.1",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-react": "^7.19.0",
    "formik": "^2.2.9",
    "framer-motion": "^1.2.4",
    "front-matter": "^3.0.1",
    "globby": "^8.0.1",
    "handlebars": "^4.1.2",
    "husky": "4.2.3",
    "is-react": "^1.3.3",
    "lerna": "^3.18.1",
    "lerna-changelog": "^0.7.0",
    "lint-staged": "^10.1.2",
    "lodash.get": "^4.4.2",
    "meow": "^5.0.0",
    "multimatch": "^2.1.0",
    "plop": "^2.3.0",
    "polished": "^3.3.0",
    "react": "^16.8.0",
    "react-dev-utils": "^6.1.1",
    "react-dom": "^16.8.0",
    "react-helmet": "^5.2.1",
    "react-spring": "^8.0.15",
    "react-stripe-elements": "^2.0.3",
    "react-text-mask": "^5.4.3",
    "rehype-stringify": "^5.0.0",
    "remark-parse": "^6.0.3",
    "remark-rehype": "^4.0.0",
    "strip-ansi": "^4.0.0",
    "tempy": "^0.2.1",
    "text-mask-addons": "^3.8.0",
    "unified": "^7.1.0",
    "universal-cookie": "^3.0.7",
    "wait-for-localhost": "2.0.1",
    "webpack": "4.28.4",
    "xstate": "^4.7.0-rc5",
    "yup": "^0.29.3"
  },
  "dependencies": {
    "@rtm-ui/a": "file:packages/a",
    "@rtm-ui/accordion": "file:packages/accordion",
    "@rtm-ui/animate": "file:packages/animate",
    "@rtm-ui/bootstrap": "file:packages/bootstrap",
    "@rtm-ui/button": "file:packages/button",
    "@rtm-ui/csrf": "file:packages/csrf",
    "@rtm-ui/dashboard": "file:packages/dashboard",
    "@rtm-ui/dialog": "file:packages/dialog",
    "@rtm-ui/dynamic-svg": "file:packages/dynamic-svg",
    "@rtm-ui/electricity-switch": "file:packages/electricity-switch",
    "@rtm-ui/error-boundary": "file:packages/error-boundary",
    "@rtm-ui/feature-tile": "file:packages/feature-tile",
    "@rtm-ui/footer": "file:packages/footer",
    "@rtm-ui/form": "file:packages/form",
    "@rtm-ui/hero": "file:packages/hero",
    "@rtm-ui/how-it-works": "file:packages/how-it-works",
    "@rtm-ui/hybrid-login-view": "file:packages/hybrid-login-view",
    "@rtm-ui/i18n": "file:packages/i18n",
    "@rtm-ui/icon": "file:packages/icon",
    "@rtm-ui/img": "file:packages/img",
    "@rtm-ui/layout": "file:packages/layout",
    "@rtm-ui/list": "file:packages/list",
    "@rtm-ui/login-calculator-panel": "file:packages/login-calculator-panel",
    "@rtm-ui/login-panel": "file:packages/login-panel",
    "@rtm-ui/multi-list": "file:packages/multi-list",
    "@rtm-ui/nav": "file:packages/nav",
    "@rtm-ui/phoneback": "file:packages/phoneback",
    "@rtm-ui/plan": "file:packages/plan",
    "@rtm-ui/plan-selector": "file:packages/plan-selector",
    "@rtm-ui/readfile": "file:packages/readfile",
    "@rtm-ui/seo": "file:packages/seo",
    "@rtm-ui/switch-confirm-page": "file:packages/switch-confirm-page",
    "@rtm-ui/testimonial": "file:packages/testimonial",
    "@rtm-ui/theme": "file:packages/theme",
    "@rtm-ui/tracker": "file:packages/tracker",
    "@rtm-ui/typography": "file:packages/typography",
    "@rtm-ui/video-dialog": "file:packages/video-dialog",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^11.2.7",
    "core-js": "^3.4.7",
    "react-testing-library": "^6.1.2"
  },
  "eslintConfig": {
    "extends": [
      "@rtm/eslint-config"
    ]
  },
  "eslintIgnore": [
    "packages/**/build/**/*.js",
    "packages/**/coverage",
    "packages/**/*.md",
    "packages/**/node_modules/*.js",
    "templates/plopfile.js"
  ],
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,css,json,md}": [
      "prettier --write"
    ],
    "*.js": []
  }
}
