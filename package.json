{
  "private": true,
  "rtmRollup": {
    "globalMap": {
      "styled-components": "styled",
      "cloneDeep": "lodash.clonedeep",
      "toPath": "lodash.topath"
    }
  },
  "scripts": {
    "bootstrap": "lerna bootstrap --hoist",
    "commit": "npx git-cz",
    "serve": "curl pad.js.org | node",
    "dev": "docz dev",
    "lint": "eslint packages",
    "test": "CI=true lerna run test --no-sort --stream --concurrency 999 -- -- --coverage",
    "test-coverage": "npm run test-watch -- -- --coverage --color",
    "test-updateSnapshot": "CI=true npm run test-watch -- -- --updateSnapshot --color",
    "test-watch": "lerna exec --no-sort --stream --concurrency 999 -- npm run test",
    "release": "lerna publish --yes",
    "generate": "plop --plopfile ./templates/plopfile.js"
  },
  "devDependencies": {
    "@babel/cli": "^7.2.3",
    "@babel/core": "^7.2.2",
    "axios": "^0.18.0",
    "commitizen": "^3.0.5",
    "cz-conventional-changelog": "^2.1.0",
    "docz": "^0.13",
    "docz-theme-default": "^0.13.5",
    "eslint": "^5.9.0",
    "eslint-config-airbnb": "^17.1.0",
    "eslint-plugin-import": "^2.14.0",
    "eslint-plugin-jsx-a11y": "^6.1.2",
    "eslint-plugin-react": "^7.11.1",
    "execa": "1.0.0",
    "formik": "^1.4.1",
    "fs-extra": "7.0.0",
    "get-port": "^4.0.0",
    "globby": "^8.0.1",
    "husky": "^1.1.4",
    "jest": "23.6.0",
    "jest-dom": "^2.1.1",
    "jest-pnp-resolver": "1.0.1",
    "jest-resolve": "23.6.0",
    "lerna": "3.5.0",
    "lerna-changelog": "^0.7.0",
    "lint-staged": "^7.0.5",
    "meow": "^5.0.0",
    "multimatch": "^2.1.0",
    "plop": "^2.1.0",
    "prettier": "1.14.3",
    "react": "^16.8.0",
    "react-dom": "^16.8.0",
    "react-dev-utils": "^6.1.1",
    "react-stripe-elements": "^2.0.3",
    "react-text-mask": "^5.4.3",
    "strip-ansi": "^4.0.0",
    "tempy": "^0.2.1",
    "text-mask-addons": "^3.8.0",
    "universal-cookie": "^3.0.7",
    "wait-for-localhost": "2.0.1",
    "webpack": "^4.28.4",
    "yup": "^0.26.10"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "packages/**/*/*.{js,md,css}": [
      "prettier --write",
      "eslint"
    ],
    "yarn.lock": [
      "git rm --cached"
    ]
  },
  "dependencies": {
    "@rebass/grid": "^6.0.0-7",
    "eslint-config-prettier": "^3.3.0",
    "eslint-plugin-prettier": "^3.0.0",
    "lodash.clonedeep": "^4.5.0",
    "lodash.topath": "^4.5.2",
    "logrocket": "^0.6.17",
    "styled-components": "^4.1.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
