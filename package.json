{
  "private": true,
  "rtmRollup": {
    "globalMap": {
      "styled-components": "styled",
      "cloneDeep": "lodash.clonedeep",
      "toPath": "lodash.topath"
    }
  },
  "scripts": {
    "bootstrap": "lerna bootstrap",
    "commit": "npx git-cz",
    "serve": "curl pad.js.org | node",
    "dev": "docz dev",
    "lint": "eslint packages",
    "test": "lerna run test --parallel --no-sort --stream --concurrency 999 -- -- --coverage",
    "test-watch": "lerna exec --no-sort --stream --concurrency 999 -- npm run test",
    "release": "lerna publish --yes",
    "generate": "plop --plopfile ./templates/plopfile.js",
    "watch": "lerna run --parallel build -- -- --watch"
  },
  "devDependencies": {
    "@babel/cli": "^7.2.3",
    "@babel/core": "^7.2.2",
    "axios": "^0.18.0",
    "babel-core": "^7.0.0-bridge.0",
    "babel-preset-react": "^6.24.1",
    "buble": "^0.19.6",
    "commitizen": "^3.0.5",
    "cz-conventional-changelog": "^2.1.0",
    "date-fns": "^1.30.1",
    "docz": "0.13.7",
    "docz-theme-default": "0.13.7",
    "eslint": "^5.9.0",
    "eslint-config-airbnb": "^17.1.0",
    "eslint-plugin-import": "^2.14.0",
    "eslint-plugin-jsx-a11y": "^6.1.2",
    "eslint-plugin-react": "^7.11.1",
    "execa": "1.0.0",
    "formik": "^1.4.1",
    "fs-extra": "7.0.0",
    "get-port": "^4.0.0",
    "globby": "^8.0.1",
    "husky": "^1.1.4",
    "jest": "23.6.0",
    "jest-dom": "^2.1.1",
    "jest-pnp-resolver": "1.0.1",
    "jest-resolve": "23.6.0",
    "jest-styled-components": "^6.2.2",
    "lerna": "^3.13.0",
    "lerna-changelog": "^0.7.0",
    "lint-staged": "^7.0.5",
    "meow": "^5.0.0",
    "multimatch": "^2.1.0",
    "plop": "^2.1.0",
    "prettier": "1.14.3",
    "react": "^16.8.0",
    "react-dev-utils": "^6.1.1",
    "react-dom": "^16.8.0",
    "react-spring": "^8.0.15",
    "react-stripe-elements": "^2.0.3",
    "react-testing-library": "^5.2.3",
    "react-text-mask": "^5.4.3",
    "rollup": "^0.67.0",
    "rollup-plugin-babel": "^4.0.3",
    "rollup-plugin-node-resolve": "^3.4.0",
    "rollup-plugin-replace": "^2.1.0",
    "rollup-plugin-uglify": "^6.0.0",
    "strip-ansi": "^4.0.0",
    "tempy": "^0.2.1",
    "text-mask-addons": "^3.8.0",
    "universal-cookie": "^3.0.7",
    "wait-for-localhost": "2.0.1",
    "webpack": "4.28.4",
    "yup": "^0.26.10"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "packages/**/*/*.{js,md,css}": [
      "prettier --write",
      "eslint"
    ],
    "yarn.lock": [
      "git rm --cached"
    ]
  },
  "dependencies": {
    "@rtm-ui/animate": "file:packages/animate",
    "@rtm-ui/a": "file:packages/a",
    "@rtm-ui/bootstrap": "file:packages/bootstrap",
    "@rtm-ui/button": "file:packages/button",
    "@rtm-ui/dialog": "file:packages/dialog",
    "@rtm-ui/feature-tile": "file:packages/feature-tile",
    "@rtm-ui/form": "file:packages/form",
    "@rtm-ui/hero": "file:packages/hero",
    "@rtm-ui/how-it-works": "file:packages/how-it-works",
    "@rtm-ui/hybrid-login-view": "file:packages/hybrid-login-view",
    "@rtm-ui/icon": "file:packages/icon",
    "@rtm-ui/img": "file:packages/img",
    "@rtm-ui/layout": "file:packages/layout",
    "@rtm-ui/login-panel": "file:packages/login-panel",
    "@rtm-ui/nav": "file:packages/nav",
    "@rtm-ui/rtm-scripts": "file:packages/rtm-scripts",
    "@rtm-ui/testimonial": "file:packages/testimonial",
    "@rtm-ui/theme": "file:packages/theme",
    "@rtm-ui/tracker": "file:packages/tracker",
    "@rtm-ui/typography": "file:packages/typography"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "name": "rtm-kit"
}
