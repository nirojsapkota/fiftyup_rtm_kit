{
  "version": "independent",
  "lerna": "3.5.0",
  "npmClient": "npm",
  "npmCLientArgs": "--loglevel verbose",
  "command": {
    "create": {
      "license": "Proprietary"
    },
    "publish": {
      "registry": "https://repo.revtech.media/dev/registry/",
      "allowBranch": "master",
      "bump": "prerelease",
      "conventionalCommits": true,
      "message": "chore(release): Publish",
      "preid": "rc",
      "verifyAccess": false,
      "ignoreChanges": [
        "*.md",
        "**/*.md",
        "**/examples/**",
        "**/__tests__/**",
        "**/docz/**"
      ]
    }
  },
  "packages": ["packages/*"]
}
