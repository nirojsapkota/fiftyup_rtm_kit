{
  "version": "independent",
  "useWorkspaces": true,
  "command": {
    "create": {
      "license": "Proprietary"
    },
    "publish": {
      "allowBranch": "master",
      "bump": "prerelease",
      "conventionalCommits": true,
      "message": "chore(release): Publish",
      "preid": "rc",
      "npmClient": "yarn",
      "ignoreChanges": [
          "*.md",
          "**/*.md",
          "**/examples/**",
          "**/__tests__/**",
          "**/docz/**"
      ]
    }
  },
  "packages": [
      "packages/*"
  ]
}
