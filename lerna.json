{
  "version": "independent",
  "npmClient": "npm",
  "npmCLientArgs": "--loglevel verbose",
  "command": {
    "create": {
      "license": "Proprietary"
    },
    "publish": {
      "registry": "https://ri8ml7zb9i.execute-api.ap-southeast-2.amazonaws.com/dev/registry/",
      "allowBranch": "master",
      "bump": "prerelease",
      "conventionalCommits": true,
      "message": "chore(release): Publish",
      "preid": "rc",
      "verifyAccess": false,
      "ignoreChanges": [
          "*.md",
          "**/*.md",
          "**/examples/**",
          "**/__tests__/**",
          "**/docz/**"
      ]
    }
  },
  "packages": [
      "packages/*"
  ]
}
