    -ms-flex-align: center;
    align-items: center;
  }

  .c44 > p {
    padding-right: 20px;
  }

  .c44:after {
    position: absolute;
    width: 0;
    height: 0;
    content: '';
    z-index: 2;
    right: auto;
    top: auto;
    bottom: -15px;
    left: calc(50% - 12px);
    border-left: 10px solid transparent;
    border-right: 10px solid transparent;
    border-top: 16px solid #083d87;
  }

  .c44:first-child,
  .c44:last-child {
    padding-left: 0px;
    -webkit-flex-direction: row;
    -ms-flex-direction: row;
    flex-direction: row;
  }

  .c44:first-child > p,
  .c44:last-child > p {
    padding-left: 20px;
    padding-right: 0px;
  }
}

@media (min-width:76em) {
  .c44 > p {
    padding-right: 40px;
  }

  .c44:first-child,
  .c44:last-child {
    padding-left: 0px;
    -webkit-flex-direction: row;
    -ms-flex-direction: row;
    flex-direction: row;
  }

  .c44:first-child > p,
  .c44:last-child > p {
    padding-left: 40px;
    padding-right: 0px;
  }
}

@media (max-width:46em) {
  .c11 {
    display: none;
  }
}

@media (min-width:46em) {
  .c50 {
    display: none;
  }
}

